{
  "name": "symbol-mcp",
  "version": "0.1.0",
  "description": "Look up signatures, props, parameters, defaults and docblocks of functions, components and classes in a codebase (TypeScript, JavaScript, PHP). Works as an MCP server and as a CLI.",
  "type": "module",
  "bin": {
    "symbol-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars",
    "llms-full.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-grammars.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ignore": "^7.0.13",
    "typescript": "5.9.3",
    "web-tree-sitter": "^0.27.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tree-sitter-php": "0.24.2"
  },
  "license": "PolyForm-Strict-1.0.0"
}
